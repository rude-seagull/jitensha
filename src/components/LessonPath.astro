---
import Stamp from './Stamp.astro';
import SystemIcon from './SystemIcon.astro';
import { lessonUrl, type Lesson } from '../lib/curriculum';

/*
 * An ordered lesson sequence drawn as a serpentine: cards flow left to right, and at
 * the end of each row the connector sweeps back to the left to start the next one.
 *
 * The layout is a grid with a COLUMN COUNT FIXED PER BREAKPOINT rather than a wrapping
 * flex row. That is the whole trick: with the column count known, `nth-child` can tell
 * exactly which card ends a row and which one opens the next, so every connector is
 * placed in pure CSS with no JavaScript and no measurement.
 *
 * The hue advances with the sequence. Each step carries `--t`, its position from 0 to 1,
 * computed here; CSS mixes indigo → asagi by that ratio. The gradient is therefore a
 * property of the data rather than decoration painted over it — and it costs nothing at
 * runtime: no image, no canvas, no script.
 *
 * Robustness note: the NUMBERS carry the sequence; the connectors only reinforce it. A
 * connector misbehaving at some unforeseen width cannot make the order ambiguous.
 */

interface Props {
  lessons: Lesson[];
  label: string;
}

const { lessons, label } = Astro.props;
const ids = lessons.map((lesson) => lesson.id);
const last = Math.max(1, lessons.length - 1);
---

<div class="path-wrap">
  <ol class="path" aria-label={label}>
    {
      lessons.map((lesson, index) => (
        <li
          class="step"
          data-lesson-card
          data-lesson={lesson.id}
          style={`--t:${(index / last).toFixed(4)}`}
        >
          <a class="step__card" href={lessonUrl(lesson)}>
            <span class="step__head">
              <span class="step__node num">{String(index + 1).padStart(2, '0')}</span>
              {/* The system's defining artefact — the caliper, the 3-cross lacing, the
                  rotor — so a card still says what it belongs to out of context. */}
              <span class="step__mark" aria-hidden="true">
                <SystemIcon system={lesson.data.system} size={22} />
              </span>
            </span>
            <span class="step__title">{lesson.data.title}</span>
            <span class="step__meta">
              <span class="num">{lesson.data.duration} min</span>
              {lesson.data.safety.length > 0 && <span class="step__safety">Sécurité</span>}
              <span class="step__done" data-done-mark hidden aria-label="Terminée">
                ✓
              </span>
            </span>
          </a>
          {/* Horizontal connector toward the next card; CSS hides it at row ends. */}
          <span class="step__flow" aria-hidden="true" />
          {/* Arrowhead from the return sweep. Kept outside the card so the hover lift
              cannot detach it from the line. */}
          <span class="step__enter" aria-hidden="true" />
        </li>
      ))
    }
  </ol>

  {/* Lands once every lesson of this sequence is complete. */}
  <p class="path__end" data-path-complete={ids.join(',')}>
    <Stamp size="md" label={`${label} — terminé`} hidden />
  </p>
</div>

<style>
  .path-wrap {
    --gap-x: 2.75rem;
    --gap-y: 3.5rem;
    --gap-half: calc(var(--gap-y) / 2);
    --card-h: 11.5rem;
    --dash: 5px;
  }

  .path {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    column-gap: var(--gap-x);
    row-gap: var(--gap-y);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .step {
    position: relative;
    /* Position along the sequence, mixed from the two brand colours. Both endpoints
       clear contrast on every ground, so every blend between them does too. */
    --hue: color-mix(in oklab, var(--indigo), var(--asagi) calc(var(--t) * 100%));
  }

  /* ---- Card: fixed height, which is what keeps the grid geometry knowable ---- */

  .step__card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: var(--card-h);
    padding: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--ink);
    transition:
      transform var(--hover),
      border-color var(--hover);
  }

  .step__card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in oklab, var(--hue) 55%, transparent);
  }

  /* Elevation rides on opacity so hover stays off the layout and paint paths. */
  .step__card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: var(--shadow-card);
    opacity: 0;
    transition: opacity var(--hover);
    pointer-events: none;
  }

  .step__card:hover::after {
    opacity: 1;
  }

  .step__node {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    flex-shrink: 0;
    border: 1px solid color-mix(in oklab, var(--hue) 45%, transparent);
    border-radius: var(--radius-sm);
    background: color-mix(in oklab, var(--hue) 9%, var(--surface));
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--hue);
  }

  .step__title {
    flex: 1;
    font-weight: 650;
    font-size: var(--text-base);
    line-height: var(--leading-snug);
    /* Three lines, not two: at 18px a 50-character title can need a third when the
       words break badly. The card is sized for three so nothing ever clips. */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }

  .step__card:hover .step__title {
    color: var(--hue);
  }

  .step__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--acier);
  }

  .step__safety {
    color: var(--vermillon);
    font-weight: 600;
  }

  .step__done {
    margin-inline-start: auto;
    color: var(--valide);
    font-weight: 700;
  }

  .step__head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .step__mark {
    display: flex;
    color: var(--hue);
    opacity: 0.55;
    transition:
      opacity var(--hover),
      transform var(--hover);
  }

  .step__card:hover .step__mark {
    opacity: 1;
    transform: translateX(2px);
  }

  .step[data-done='true'] .step__card {
    background: var(--valide-soft);
    border-color: transparent;
  }

  .step[data-done='true'] .step__node {
    background: var(--valide);
    border-color: var(--valide);
    color: var(--surface);
  }

  .step[data-done='true'] .step__mark {
    color: var(--valide);
  }

  @media (prefers-reduced-motion: reduce) {
    .step__card:hover,
    .step__card:hover .step__mark {
      transform: none;
    }
  }

  /* ---- Connectors ----------------------------------------------------------
   *
   * Four pieces, meeting at the MIDDLE of the row gap so the run never touches a card:
   *
   *   [ card ]--flow-->[ card ]          .step__flow    horizontal, between cards
   *      |                    |
   *      |                 ::after       drop from a row-end card to mid-gap
   *   ::before <--- run ------'          run at mid-gap, then drop into the next card
   *      v
   *   .step__enter                       arrowhead into the card
   *
   * Dashes are painted with repeating gradients rather than `border-style: dashed`,
   * which keeps the phase identical on horizontal and vertical runs and avoids a
   * ragged corner where they join.
   */

  .step__flow {
    position: absolute;
    left: 100%;
    top: calc(var(--card-h) / 2);
    width: calc(var(--gap-x) - 5px);
    height: 1px;
    background-image: repeating-linear-gradient(
      to right,
      var(--hue) 0 var(--dash),
      transparent var(--dash) calc(var(--dash) * 2)
    );
  }

  .step__flow::after {
    content: '';
    position: absolute;
    left: 100%;
    top: -3.5px;
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    border-left: 5px solid var(--hue);
  }

  /* Row end: drop from the card down to mid-gap. */
  .step::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 100%;
    width: 1px;
    height: var(--gap-half);
    background-image: repeating-linear-gradient(
      to bottom,
      var(--hue) 0 var(--dash),
      transparent var(--dash) calc(var(--dash) * 2)
    );
  }

  /*
   * Row start: the return run at mid-gap, then the drop into this card. The width is
   * the exact centre-to-centre distance back across the row; `max()` keeps the box
   * paintable at one column, where that distance collapses to zero and only the drop
   * should remain.
   */
  .step::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 100%;
    width: max(1px, calc((var(--cols) - 1) * (100% + var(--gap-x))));
    height: var(--gap-half);
    background-image:
      repeating-linear-gradient(
        to right,
        var(--hue) 0 var(--dash),
        transparent var(--dash) calc(var(--dash) * 2)
      ),
      repeating-linear-gradient(
        to bottom,
        var(--hue) 0 var(--dash),
        transparent var(--dash) calc(var(--dash) * 2)
      );
    background-size:
      100% 1px,
      1px 100%;
    background-position:
      left top,
      left top;
    background-repeat: no-repeat;
  }

  .step__enter {
    position: absolute;
    left: calc(50% - 4px);
    bottom: 100%;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid var(--hue);
  }

  /* ---- Column counts, and the connector rules that follow from them ---------
   *
   * Ranges are mutually exclusive on purpose. With overlapping `min-width` blocks a
   * lower breakpoint's `nth-child` rule (0,3,0) outranks a higher one's reset (0,2,0)
   * and media queries add no specificity, so two-column sweeps survived into the
   * four-column layout. Exclusive ranges make exactly one block apply.
   */

  .step__flow,
  .step__enter,
  .step::before,
  .step::after {
    display: none;
  }

  @media (max-width: 29.99rem) {
    .path {
      --cols: 1;
    }

    /* Every card both ends and starts a row, so the chain is drawn in two halves:
       the drop out of one card and the drop into the next. */
    .step:not(:last-child)::after {
      display: block;
    }

    .step:not(:first-child)::before,
    .step:not(:first-child) .step__enter {
      display: block;
    }
  }

  @media (min-width: 30rem) and (max-width: 43.99rem) {
    .path {
      --cols: 2;
    }

    .step:not(:nth-child(2n)):not(:last-child) .step__flow {
      display: block;
    }

    .step:nth-child(2n):not(:last-child)::after {
      display: block;
    }

    .step:nth-child(2n + 1):not(:first-child)::before,
    .step:nth-child(2n + 1):not(:first-child) .step__enter {
      display: block;
    }
  }

  @media (min-width: 44rem) and (max-width: 63.99rem) {
    .path {
      --cols: 3;
    }

    .step:not(:nth-child(3n)):not(:last-child) .step__flow {
      display: block;
    }

    .step:nth-child(3n):not(:last-child)::after {
      display: block;
    }

    .step:nth-child(3n + 1):not(:first-child)::before,
    .step:nth-child(3n + 1):not(:first-child) .step__enter {
      display: block;
    }
  }

  @media (min-width: 64rem) {
    .path {
      --cols: 4;
    }

    .step:not(:nth-child(4n)):not(:last-child) .step__flow {
      display: block;
    }

    .step:nth-child(4n):not(:last-child)::after {
      display: block;
    }

    .step:nth-child(4n + 1):not(:first-child)::before,
    .step:nth-child(4n + 1):not(:first-child) .step__enter {
      display: block;
    }
  }

  /* ---- End of sequence ------------------------------------------------------ */

  .path__end {
    display: flex;
    justify-content: flex-end;
    margin-top: var(--space-4);
    min-height: 3.75rem;
  }
</style>
