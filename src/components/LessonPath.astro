---
import Stamp from './Stamp.astro';
import { lessonUrl, type Lesson } from '../lib/curriculum';

/*
 * An ordered lesson sequence drawn as a serpentine: cards flow left to right, and at
 * the end of each row the connector sweeps back to the left to start the next one.
 *
 * The layout is a grid with a COLUMN COUNT FIXED PER BREAKPOINT rather than a wrapping
 * flex row. That is the whole trick: with the column count known, `nth-child` can tell
 * exactly which card ends a row and which one opens the next, so every connector is
 * placed in pure CSS with no JavaScript and no measurement.
 *
 * The return sweep is drawn by `.step::before` on the card that opens a row. Its width
 * is `(cols - 1) × (100% + gap)` — precisely the centre-to-centre distance back to the
 * last card of the previous row, since all columns are equal. At one column that
 * expression collapses to zero and the sweep degenerates into the vertical connector a
 * single-column chain needs, which is why the mobile case needs no special handling.
 *
 * Robustness note: the NUMBERS carry the sequence; the arrows only reinforce it. A
 * connector misbehaving at some unforeseen width cannot make the order ambiguous.
 */

interface Props {
  lessons: Lesson[];
  label: string;
}

const { lessons, label } = Astro.props;
const ids = lessons.map((lesson) => lesson.id);
---

<div class="path-wrap">
  <ol class="path" aria-label={label}>
    {
      lessons.map((lesson, index) => (
        <li class="step" data-lesson-card data-lesson={lesson.id}>
          <a class="step__card" href={lessonUrl(lesson)}>
            <span class="step__node num">{String(index + 1).padStart(2, '0')}</span>
            <span class="step__title">{lesson.data.title}</span>
            <span class="step__meta">
              <span class="num">{lesson.data.duration} min</span>
              {lesson.data.safety.length > 0 && <span class="step__safety">Sécurité</span>}
              <span class="step__done" data-done-mark hidden aria-label="Terminée">
                ✓
              </span>
            </span>
          </a>
          {/* Horizontal connector toward the next card; CSS hides it at row ends. */}
          <span class="step__flow" aria-hidden="true" />
        </li>
      ))
    }
  </ol>

  {/* Lands once every lesson of this sequence is complete. */}
  <p class="path__end" data-path-complete={ids.join(',')}>
    <Stamp size="md" label={`${label} — terminé`} hidden />
  </p>
</div>

<style>
  .path-wrap {
    --gap-x: 2.75rem;
    --gap-y: 3.25rem;
    --card-h: 8.75rem;
  }

  .path {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    column-gap: var(--gap-x);
    row-gap: var(--gap-y);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .step {
    position: relative;
  }

  /* ---- Card: fixed height, which is what keeps the grid geometry knowable ---- */

  .step__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: var(--card-h);
    padding: var(--space-3) var(--space-4) var(--space-3) var(--space-3);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--ink);
    transition:
      border-color var(--transition),
      background var(--transition);
  }

  .step__card:hover {
    border-color: var(--indigo);
  }

  .step__node {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    flex-shrink: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--acier);
    background: var(--paper);
  }

  .step__title {
    flex: 1;
    font-weight: 650;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    /* Safety net only: Niveau 1 titles are capped at 52 characters upstream. */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .step__card:hover .step__title {
    color: var(--indigo);
  }

  .step__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--acier);
  }

  .step__safety {
    color: var(--vermillon);
    font-weight: 600;
  }

  .step__done {
    margin-inline-start: auto;
    color: var(--valide);
    font-weight: 700;
  }

  .step[data-done='true'] .step__card {
    background: var(--valide-soft);
    border-color: transparent;
  }

  .step[data-done='true'] .step__node {
    background: var(--valide);
    border-color: var(--valide);
    color: var(--surface);
  }

  /* ---- Connectors ----------------------------------------------------------
   *
   * Four pieces, meeting at the MIDDLE of the row gap so the run never touches a card:
   *
   *   [ card ]--flow-->[ card ]          .step__flow   horizontal, between cards
   *      |                    |
   *      |                 ::after       drop from a row-end card to mid-gap
   *   ::before <--- run ------'          run at mid-gap, then drop into the next card
   *      v
   *   [ card ]                           .step__card::before   arrowhead
   *
   * Dashes are painted with repeating gradients rather than `border-style: dashed`,
   * which keeps the phase identical on horizontal and vertical runs and avoids a
   * ragged corner where they join.
   */

  .path-wrap {
    --dash: 5px;
    --gap-half: calc(var(--gap-y) / 2);
  }

  /* Horizontal run toward the next card in the same row. */
  .step__flow {
    position: absolute;
    left: 100%;
    top: calc(var(--card-h) / 2);
    width: calc(var(--gap-x) - 5px);
    height: 1px;
    background-image: repeating-linear-gradient(
      to right,
      var(--path-line) 0 var(--dash),
      transparent var(--dash) calc(var(--dash) * 2)
    );
  }

  .step__flow::after {
    content: '';
    position: absolute;
    left: 100%;
    top: -3.5px;
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    border-left: 5px solid var(--path-line);
  }

  /* Row end: drop from the card down to mid-gap. */
  .step::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 100%;
    width: 1px;
    height: var(--gap-half);
    background-image: repeating-linear-gradient(
      to bottom,
      var(--path-line) 0 var(--dash),
      transparent var(--dash) calc(var(--dash) * 2)
    );
  }

  /*
   * Row start: the return run at mid-gap, then the drop into this card. The width is
   * the exact centre-to-centre distance back across the row; `max()` keeps the box
   * paintable at one column, where that distance collapses to zero and only the drop
   * should remain.
   */
  .step::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 100%;
    width: max(1px, calc((var(--cols) - 1) * (100% + var(--gap-x))));
    height: var(--gap-half);
    background-image:
      repeating-linear-gradient(
        to right,
        var(--path-line) 0 var(--dash),
        transparent var(--dash) calc(var(--dash) * 2)
      ),
      repeating-linear-gradient(
        to bottom,
        var(--path-line) 0 var(--dash),
        transparent var(--dash) calc(var(--dash) * 2)
      );
    background-size:
      100% 1px,
      1px 100%;
    background-position:
      left top,
      left top;
    background-repeat: no-repeat;
  }

  /* Arrowhead entering the card the return leads to. */
  .step__card::before {
    content: '';
    position: absolute;
    left: calc(50% - 4px);
    bottom: 100%;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid var(--path-line);
  }

  /* ---- Column counts, and the connector rules that follow from them ---------
   *
   * Ranges are mutually exclusive on purpose. With overlapping `min-width` blocks a
   * lower breakpoint's `nth-child` rule (0,3,0) outranks a higher one's reset (0,2,0)
   * and media queries add no specificity, so two-column sweeps survived into the
   * four-column layout. Exclusive ranges make exactly one block apply.
   */

  .step__flow,
  .step::before,
  .step::after,
  .step__card::before {
    display: none;
  }

  @media (max-width: 29.99rem) {
    .path {
      --cols: 1;
    }

    /* Every card both ends and starts a row, so the chain is drawn in two halves:
       the drop out of one card and the drop into the next. */
    .step:not(:last-child)::after {
      display: block;
    }

    .step:not(:first-child)::before,
    .step:not(:first-child) .step__card::before {
      display: block;
    }
  }

  @media (min-width: 30rem) and (max-width: 43.99rem) {
    .path {
      --cols: 2;
    }

    .step:not(:nth-child(2n)):not(:last-child) .step__flow {
      display: block;
    }

    .step:nth-child(2n):not(:last-child)::after {
      display: block;
    }

    .step:nth-child(2n + 1):not(:first-child)::before,
    .step:nth-child(2n + 1):not(:first-child) .step__card::before {
      display: block;
    }
  }

  @media (min-width: 44rem) and (max-width: 63.99rem) {
    .path {
      --cols: 3;
    }

    .step:not(:nth-child(3n)):not(:last-child) .step__flow {
      display: block;
    }

    .step:nth-child(3n):not(:last-child)::after {
      display: block;
    }

    .step:nth-child(3n + 1):not(:first-child)::before,
    .step:nth-child(3n + 1):not(:first-child) .step__card::before {
      display: block;
    }
  }

  @media (min-width: 64rem) {
    .path {
      --cols: 4;
    }

    .step:not(:nth-child(4n)):not(:last-child) .step__flow {
      display: block;
    }

    .step:nth-child(4n):not(:last-child)::after {
      display: block;
    }

    .step:nth-child(4n + 1):not(:first-child)::before,
    .step:nth-child(4n + 1):not(:first-child) .step__card::before {
      display: block;
    }
  }

  /* ---- End of sequence ------------------------------------------------------ */

  .path__end {
    display: flex;
    justify-content: flex-end;
    margin-top: var(--space-4);
    min-height: 3.75rem;
  }
</style>
