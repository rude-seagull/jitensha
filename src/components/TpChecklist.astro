---
import Stamp from './Stamp.astro';

interface Props {
  lessonId: string;
  exercises: { title: string; summary: string; criteria: string[] }[];
}

const { lessonId, exercises } = Astro.props;
---

<section class="tp" aria-labelledby="travaux-pratiques">
  <h2 id="travaux-pratiques">
    {exercises.length > 1 ? 'Travaux pratiques' : 'Travail pratique'}
  </h2>

  {
    exercises.map((exercise, index) => (
      <article class="tp__item" data-exercise-card={index}>
        <h3 class="tp__title">{exercise.title}</h3>
        <p class="tp__summary">{exercise.summary}</p>

        <p class="eyebrow tp__criteria-title">
          Critères de validation · <span class="num">{exercise.criteria.length}</span>
        </p>
        {/*
          A plain numbered list server-side; src/scripts/checklist.js upgrades each
          item into a persistent checkbox. Without JavaScript it stays readable and
          printable — which is the point at the workbench.
        */}
        <ol class="tp__criteria" data-checklist data-lesson={lessonId} data-exercise={index}>
          {exercise.criteria.map((criterion) => (
            <li class="criterion" data-criterion>
              <span data-criterion-text>{criterion}</span>
            </li>
          ))}
        </ol>

        {/* Lands only once every criterion is ticked. */}
        <Stamp size="md" label="Travail pratique validé" hidden />
      </article>
    ))
  }
</section>

<style>
  .tp__item + .tp__item {
    margin-top: var(--space-5);
  }

  .tp__item {
    position: relative;
    margin-top: var(--space-4);
    padding: var(--space-5);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    transition: border-color var(--transition);
  }

  .tp__item[data-complete] {
    border-color: var(--vermillon-line);
  }

  .tp__title {
    font-size: var(--text-lg);
    max-width: 46ch;
  }

  .tp__summary {
    margin-top: var(--space-2);
    color: var(--ink-muted);
    max-width: var(--measure);
  }

  .tp__criteria-title {
    margin-top: var(--space-5);
  }

  .tp__criteria {
    margin-top: var(--space-3);
    padding-left: var(--space-5);
    display: grid;
    gap: var(--space-2);
    max-width: var(--measure);
  }

  /* Once enhanced the native markers give way to checkboxes. */
  .tp__criteria[data-enhanced] {
    list-style: none;
    padding-left: 0;
    gap: var(--space-1);
  }

  .criterion :global(.criterion__box) {
    margin-inline-end: var(--space-3);
    width: 1.05rem;
    height: 1.05rem;
    accent-color: var(--valide);
    flex-shrink: 0;
    margin-top: 0.28em;
  }

  .tp__criteria[data-enhanced] .criterion :global([data-criterion-text]) {
    display: flex;
    align-items: flex-start;
    padding: var(--space-2);
    border-radius: var(--radius-sm);
    transition: background var(--transition);
  }

  .tp__criteria[data-enhanced] .criterion :global([data-criterion-text]):hover {
    background: var(--surface-sunken);
  }

  .criterion :global(.criterion__label) {
    cursor: pointer;
  }

  .criterion[data-checked='true'] :global(.criterion__label) {
    color: var(--acier);
    text-decoration: line-through;
    text-decoration-color: var(--line-strong);
  }

  /* In flow and right-aligned, so it can never land on a criterion. */
  .tp__item :global(.stamp) {
    margin-top: var(--space-4);
    margin-inline-start: auto;
    display: block;
  }
</style>
