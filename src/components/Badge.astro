---
interface Props {
  tone?: 'neutral' | 'level';
  /** Outline-only variant for secondary metadata. */
  subtle?: boolean;
}

const { tone = 'neutral', subtle = false } = Astro.props;
---

<span class="badge" data-tone={tone} data-subtle={subtle ? 'true' : undefined}>
  <slot />
</span>

<style>
  /*
   * Deliberately only two tones. Vermilion is reserved for the stamp and safety, so a
   * "warning" badge would dilute the one colour that has to mean something.
   */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.2em 0.65em;
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1.6;
    white-space: nowrap;
    background: var(--surface-sunken);
    color: var(--ink-muted);
    border: 1px solid transparent;
  }

  .badge[data-tone='level'] {
    background: var(--indigo-soft);
    color: var(--indigo);
  }

  .badge[data-subtle] {
    background: transparent;
    border-color: var(--line);
    color: var(--acier);
    font-family: var(--mono);
    font-weight: 500;
  }
</style>
