---
import HeadBadge from './HeadBadge.astro';
import { href } from '../lib/paths';
---

<footer class="footer">
  <div class="page footer__inner">
    <div class="footer__brand">
      <HeadBadge size={26} />
      <p>
        Cours de mécanique vélo en accès libre. La progression est enregistrée
        localement dans le navigateur : aucun compte, aucun traceur, aucune donnée
        transmise.
      </p>
    </div>
    <nav class="footer__links" aria-label="Liens de pied de page">
      <a href={href()}>Parcours</a>
      <a href={href('atelier')}>Atelier</a>
      <a href={href('recherche')}>Recherche</a>
      <a href="https://github.com/rude-seagull/jitensha">Code source</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    margin-top: auto;
    border-top: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    justify-content: space-between;
    align-items: flex-start;
    padding-block: var(--space-6);
  }

  .footer__brand {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    max-width: 46ch;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
</style>
