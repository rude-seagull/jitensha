---
import Badge from './Badge.astro';
import { lessonUrl, levelMeta, SYSTEM_META, type Lesson } from '../lib/curriculum';

interface Props {
  lesson: Lesson;
  /** Shows the system name — useful on level pages, redundant on system pages. */
  showSystem?: boolean;
}

const { lesson, showSystem = false } = Astro.props;
const { data } = lesson;
---

<article class="card" data-lesson-card data-lesson={lesson.id}>
  <a class="card__link" href={lessonUrl(lesson)}>
    <h3 class="card__title">{data.title}</h3>
  </a>

  <p class="card__meta">
    <span class="card__done" data-done-mark hidden aria-label="Leçon terminée">✓</span>
    <span>{data.duration} min</span>
    <span aria-hidden="true">·</span>
    <span>Niveau {data.level} — {levelMeta(data.level).label}</span>
    {
      showSystem && (
        <>
          <span aria-hidden="true">·</span>
          <span>{SYSTEM_META[data.system].label}</span>
        </>
      )
    }
  </p>

  {
    data.safety.length > 0 && (
      <p class="card__safety">
        <Badge tone="warning">Sécurité</Badge>
      </p>
    )
  }
</article>

<style>
  .card {
    position: relative;
    padding: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    transition: border-color var(--transition);
  }

  .card:hover {
    border-color: var(--line-strong);
  }

  .card[data-done='true'] {
    background: var(--success-soft);
    border-color: transparent;
  }

  .card__link {
    text-decoration: none;
    color: inherit;
  }

  /* Stretches the link over the whole card so the entire surface is clickable. */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .card__title {
    font-size: var(--text-base);
    font-weight: 600;
    line-height: var(--leading-snug);
  }

  .card__link:hover .card__title {
    color: var(--accent);
  }

  .card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .card__done {
    color: var(--success);
    font-weight: 700;
  }

  .card__safety {
    margin-top: var(--space-3);
  }
</style>
