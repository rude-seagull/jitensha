---
// Rendered hidden and revealed by src/scripts/theme.js — without JavaScript the
// theme still follows the system preference, so a dead button would be noise.
---

<button type="button" class="theme-toggle" data-theme-toggle hidden>
  <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4.5"></circle>
    <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8"></path>
  </svg>
  <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    background: transparent;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    color: var(--ink-muted);
  }

  .theme-toggle:hover {
    color: var(--ink);
    border-color: var(--ink-faint);
  }

  .theme-toggle__icon {
    grid-area: 1 / 1;
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
  }

  /* Show the icon for the theme the button switches *to*. */
  .theme-toggle[data-state='light'] .theme-toggle__icon--sun,
  .theme-toggle[data-state='dark'] .theme-toggle__icon--moon {
    display: none;
  }
</style>
