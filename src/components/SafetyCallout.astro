---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <aside class="safety" aria-labelledby="securite">
      {/* The warning glyph is drawn in CSS, not written in the heading — otherwise it
          ends up inside the search index's heading text. */}
      <h2 class="safety__title" id="securite">Sécurité</h2>
      <ul class="safety__list">
        {items.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </aside>
  )
}

<style>
  .safety {
    padding: var(--space-4) var(--space-5);
    background: var(--warning-soft);
    border: 1px solid var(--warning-line);
    border-radius: var(--radius-md);
  }

  .safety__title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--warning);
  }

  .safety__title::before {
    content: '!';
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 50%;
    background: var(--warning);
    color: var(--warning-soft);
    font-size: var(--text-sm);
    font-weight: 800;
  }

  .safety__list {
    margin-top: var(--space-3);
    padding-left: var(--space-5);
    display: grid;
    gap: var(--space-2);
  }
</style>
