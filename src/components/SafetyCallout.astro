---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <aside class="safety" aria-labelledby="securite">
      {/* The glyph is drawn in CSS, not written in the heading — otherwise it ends up
          inside the search index's heading text. */}
      <h2 class="safety__title" id="securite">Sécurité</h2>
      <ul class="safety__list">
        {items.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </aside>
  )
}

<style>
  /*
   * Vermilion is stamp ink, and a safety warning is the other place it is allowed:
   * both are moments where the course tells you something is definitively true.
   */
  .safety {
    padding: var(--space-5);
    background: var(--vermillon-soft);
    border: 1px solid var(--vermillon-line);
    border-left-width: 4px;
    border-radius: var(--radius-md);
  }

  .safety__title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-lg);
    color: var(--vermillon);
  }

  .safety__title::before {
    content: '!';
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--vermillon);
    color: var(--surface);
    font-family: var(--display);
    font-size: var(--text-sm);
    font-weight: 800;
  }

  .safety__list {
    margin-top: var(--space-3);
    padding-left: var(--space-5);
    display: grid;
    gap: var(--space-3);
    max-width: var(--measure);
  }

  .safety__list li {
    color: var(--ink);
  }
</style>
