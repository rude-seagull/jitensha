---
interface Props {
  lessonId: string;
}

const { lessonId } = Astro.props;
---

{/* Revealed by src/scripts/progress.js — a dead button without JavaScript is noise. */}
<button type="button" class="complete" data-complete-toggle data-lesson={lessonId} aria-pressed="false" hidden>
  <span class="complete__mark" aria-hidden="true">✓</span>
  <span data-complete-label>Marquer comme terminée</span>
</button>

<style>
  .complete {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--ink-muted);
    transition:
      color var(--transition),
      border-color var(--transition),
      background var(--transition);
  }

  .complete:hover {
    color: var(--ink);
    border-color: var(--acier);
  }

  .complete__mark {
    opacity: 0.3;
  }

  .complete[data-state='done'] {
    background: var(--valide-soft);
    border-color: var(--valide);
    color: var(--valide);
  }

  .complete[data-state='done'] .complete__mark {
    opacity: 1;
  }
</style>
