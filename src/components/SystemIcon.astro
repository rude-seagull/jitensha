---
import type { System } from '../lib/curriculum';

/*
 * One line drawing per system, each showing the artefact that actually defines it —
 * the caliper that measures everything, the 3-cross spoke pattern, a caliper body and
 * rotor, a chainring. Same 24-unit grid, same stroke weight, so the nine read as a set.
 */

interface Props {
  system: System;
  size?: number;
}

const { system, size = 24 } = Astro.props;

const PATHS: Record<System, string> = {
  // Vernier caliper — the instrument the whole course measures with.
  'fondamentaux': `<path d="M2 7h20M2 7v10M22 7v4"/><path d="M9 7v13M9 17h5v-3H9"/><path d="M4 10v3M6.5 10v2M12 10v2M17 10v3M19.5 10v2"/>`,
  // Wheel, laced 3-cross.
  'roues-et-pneus': `<circle cx="12" cy="12" r="9.2"/><circle cx="12" cy="12" r="2.4"/><path d="M12 2.8 15.6 9.9M12 2.8 8.4 9.9M20.7 15.4 13.9 11.1M20.7 15.4 14.2 13.6M3.3 15.4 10.1 11.1M3.3 15.4 9.8 13.6"/>`,
  // Disc rotor with a caliper straddling it.
  'freinage': `<circle cx="11" cy="12" r="8.4"/><circle cx="11" cy="12" r="2.6"/><path d="M11 3.6v2.4M11 18v2.4M2.6 12H5M17 12h2.4"/><path d="M17.6 6.6h3.2a1.6 1.6 0 0 1 1.6 1.6v7.6a1.6 1.6 0 0 1-1.6 1.6h-3.2"/>`,
  // Chainring and chain run.
  'transmission': `<circle cx="9" cy="13" r="6.6"/><circle cx="9" cy="13" r="1.6"/><path d="M9 6.4v-2M15.6 13h2M9 19.6v1.6M2.4 13H4"/><circle cx="19.5" cy="7.5" r="2.6"/><path d="M13.6 8.9 17.2 6.6"/>`,
  // Headset stack in section: cups, bearings, steerer.
  'direction-et-peripheriques': `<path d="M9.5 2.5h5v19h-5z"/><path d="M5 6.5h14M5 6.5v3h14v-3M5 15h14M5 15v3h14v-3"/><circle cx="7" cy="8" r="1"/><circle cx="17" cy="8" r="1"/><circle cx="7" cy="16.5" r="1"/><circle cx="17" cy="16.5" r="1"/>`,
  // Fork leg: stanchion sliding in a lower, with the coil.
  'suspension': `<path d="M9.5 2.5h5v7h-5z"/><path d="M8 9.5h8v12H8z"/><path d="M9.8 12h4.4M9.8 14.5h4.4M9.8 17h4.4M9.8 19.5h4.4"/>`,
  // Battery cell and drive unit.
  'vae': `<rect x="2.5" y="7" width="11" height="10" rx="1.6"/><path d="M13.5 10.5h1.6v3h-1.6"/><path d="M6 12h4M8 10v4"/><circle cx="18.5" cy="12" r="3.4"/><path d="M18.5 8.6V7M18.5 17v-1.6"/>`,
  // Cottered crank — the giveaway of an old, odd machine.
  'cas-exotiques': `<circle cx="12" cy="12" r="3.4"/><path d="M12 8.6V4.2a1.6 1.6 0 0 1 1.6-1.6h2.2"/><path d="M12 15.4v4.4a1.6 1.6 0 0 1-1.6 1.6H8.2"/><path d="M14.6 6.2 16.4 5M9.4 17.8 7.6 19"/><path d="M5 12h2.6M16.4 12H19"/>`,
  // Bare frame on a workshop stand.
  'montage-et-peinture': `<path d="M6 15.5 11 6.5h6l3 9"/><path d="M11 6.5 20 15.5M6 15.5h14"/><path d="M17 6.5V4"/><path d="M13 15.5v5.5M9.5 21h7"/>`,
};
---

<svg
  class="system-icon"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  aria-hidden="true"
  set:html={PATHS[system]}
/>

<style>
  .system-icon {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex-shrink: 0;
  }
</style>
