---
import BaseLayout from '../layouts/BaseLayout.astro';
import { href } from '../lib/paths';
---

<BaseLayout title="Page introuvable" description="Cette adresse ne correspond à aucune page du site.">
  <div class="page notfound">
    <h1>Page introuvable</h1>
    <p>Cette adresse ne correspond à aucune page du site.</p>
    <ul>
      <li><a href={href()}>Parcours</a> — les cinq niveaux, du débutant au maître</li>
      <li><a href={href('atelier')}>Atelier</a> — le contenu indexé par système</li>
      <li><a href={href('recherche')}>Recherche</a> — sur l'ensemble des leçons</li>
    </ul>
  </div>
</BaseLayout>

<style>
  .notfound {
    padding-block: var(--space-8);
    min-height: 50vh;
  }

  .notfound p {
    margin-top: var(--space-4);
    color: var(--ink-muted);
  }

  .notfound ul {
    margin-top: var(--space-4);
    padding-left: var(--space-5);
    display: grid;
    gap: var(--space-2);
  }
</style>
