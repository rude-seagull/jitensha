---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ProgressBar from '../components/ProgressBar.astro';
import SystemIcon from '../components/SystemIcon.astro';
import { SYSTEM_ORDER, SYSTEM_META, systemUrl, totalHours } from '../lib/curriculum';
import { href } from '../lib/paths';

const lessons = await getCollection('lessons');

const systems = SYSTEM_ORDER.map((system) => {
  const forSystem = lessons.filter((lesson) => lesson.data.system === system);
  const levels = [...new Set(forSystem.map((lesson) => lesson.data.level))].sort();
  return {
    system,
    ...SYSTEM_META[system],
    lessons: forSystem,
    ids: forSystem.map((lesson) => lesson.id),
    hours: totalHours(forSystem),
    range: levels.length ? `niveaux ${levels[0]} à ${levels[levels.length - 1]}` : '',
  };
});
---

<BaseLayout
  title="Atelier"
  description="Les neuf systèmes du vélo : fondamentaux, roues et pneus, freinage, transmission, direction, suspension, VAE, cas exotiques, montage et peinture."
>
  <div class="page atelier">
    <Breadcrumb items={[{ label: 'Parcours', url: href() }, { label: 'Atelier' }]} />

    <header class="atelier__header">
      <h1>Atelier</h1>
      <p class="atelier__lede">
        Le même contenu, indexé par système plutôt que par niveau. Vue adaptée au
        traitement d'une panne identifiée ou à l'étude complète d'un domaine.
      </p>
    </header>

    <ul class="atelier__list">
      {
        systems.map((entry) => (
          <li class="system">
            <a class="system__link" href={systemUrl(entry.system)}>
              <span class="system__icon">
                <SystemIcon system={entry.system} size={26} />
              </span>
              <h2 class="system__name">{entry.label}</h2>
            </a>
            <p class="system__tagline">{entry.tagline}</p>
            <p class="system__meta num">
              {entry.lessons.length} leçons · {entry.range} · ≈ {entry.hours} h
            </p>
            <ProgressBar lessonIds={entry.ids} label={`Progression du système ${entry.label}`} />
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .atelier {
    padding-block: var(--space-5) var(--space-8);
  }

  .atelier__header {
    padding-block: var(--space-5) var(--space-6);
  }

  .atelier__lede {
    margin-top: var(--space-3);
    max-width: var(--measure);
    font-size: var(--text-lg);
    color: var(--ink-muted);
  }

  .atelier__list {
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
  }

  .system {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition:
      transform var(--hover),
      border-color var(--hover),
      box-shadow var(--hover);
  }

  .system:hover {
    transform: translateY(-3px);
    border-color: color-mix(in oklab, var(--asagi) 50%, transparent);
    box-shadow: var(--shadow-card);
  }

  .system__icon {
    transition:
      background var(--hover),
      color var(--hover);
  }

  .system:hover .system__icon {
    background: color-mix(in oklab, var(--asagi) 16%, var(--surface));
    color: var(--asagi);
  }

  @media (prefers-reduced-motion: reduce) {
    .system:hover {
      transform: none;
    }
  }

  .system__link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: inherit;
  }

  .system__icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    background: var(--indigo-soft);
    color: var(--indigo);
  }

  .system__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .system__name {
    font-size: var(--text-lg);
  }

  .system__link:hover .system__name {
    color: var(--indigo);
  }

  .system__tagline {
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }

  .system__meta {
    font-size: var(--text-xs);
    color: var(--acier);
  }
</style>
