---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LessonCard from '../../components/LessonCard.astro';
import ProgressBar from '../../components/ProgressBar.astro';
import { SYSTEMS } from '../../content.config';
import { groupByLevel, levelMeta, levelUrl, SYSTEM_META, totalHours } from '../../lib/curriculum';
import { href } from '../../lib/paths';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return SYSTEMS.map((system) => ({
    params: { system },
    props: { lessons: lessons.filter((lesson) => lesson.data.system === system) },
  }));
}

const { lessons } = Astro.props;
const system = Astro.params.system as (typeof SYSTEMS)[number];
const meta = SYSTEM_META[system];
const groups = groupByLevel(lessons);
const ids = lessons.map((lesson) => lesson.id);
---

<BaseLayout title={meta.label} description={meta.tagline}>
  <div class="page system-page">
    <Breadcrumb items={[{ label: 'Atelier', url: href('atelier') }, { label: meta.label }]} />

    <header class="system-page__header">
      <h1>{meta.label}</h1>
      <p class="system-page__tagline">{meta.tagline}</p>
      <p class="system-page__meta">
        {lessons.length} leçons, du niveau {groups[0]?.level} au niveau{' '}
        {groups[groups.length - 1]?.level} · ≈ {totalHours(lessons)} h d'atelier
      </p>
      <div class="system-page__progress">
        <ProgressBar lessonIds={ids} label={`Progression du système ${meta.label}`} />
      </div>
    </header>

    {
      groups.map((group) => (
        <section class="level-group" aria-labelledby={`niveau-${group.level}`}>
          <div class="level-group__head">
            <h2 id={`niveau-${group.level}`}>
              <a href={levelUrl(group.level)}>
                Niveau {group.level} — {levelMeta(group.level).label}
              </a>
            </h2>
            <span class="level-group__count">{group.lessons.length} leçons</span>
          </div>
          <div class="grid">
            {group.lessons.map((lesson) => (
              <LessonCard lesson={lesson} />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .system-page {
    padding-block: var(--space-5) var(--space-8);
  }

  .system-page__header {
    padding-block: var(--space-5) var(--space-6);
  }

  .system-page__tagline {
    margin-top: var(--space-3);
    max-width: var(--measure);
    font-size: var(--text-lg);
    color: var(--ink-muted);
  }

  .system-page__meta {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--acier);
  }

  .system-page__progress {
    margin-top: var(--space-4);
    max-width: 28rem;
  }

  .level-group + .level-group {
    margin-top: var(--space-7);
  }

  .level-group__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
  }

  .level-group__head h2 {
    font-size: var(--text-xl);
  }

  .level-group__head a {
    color: inherit;
    text-decoration: none;
  }

  .level-group__head a:hover {
    color: var(--indigo);
  }

  .level-group__count {
    font-size: var(--text-sm);
    color: var(--acier);
    white-space: nowrap;
  }

  .grid {
    margin-top: var(--space-4);
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }
</style>
