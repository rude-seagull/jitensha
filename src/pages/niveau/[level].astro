---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LessonCard from '../../components/LessonCard.astro';
import LessonPath from '../../components/LessonPath.astro';
import ProgressBar from '../../components/ProgressBar.astro';
import {
  LEVELS,
  groupBySystem,
  levelMeta,
  systemUrl,
  SYSTEM_META,
  totalHours,
} from '../../lib/curriculum';
import { href } from '../../lib/paths';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return LEVELS.map((level) => ({
    params: { level: String(level.n) },
    props: { lessons: lessons.filter((lesson) => lesson.data.level === level.n) },
  }));
}

const { lessons } = Astro.props;
const level = levelMeta(Number(Astro.params.level));
const groups = groupBySystem(lessons);
const ids = lessons.map((lesson) => lesson.id);
---

<BaseLayout
  title={`Niveau ${level.n} — ${level.label}`}
  description={level.tagline}
>
  <div class="page level-page">
    <Breadcrumb items={[{ label: 'Parcours', url: href() }, { label: `Niveau ${level.n}` }]} />

    <header class="level-page__header">
      <p class="eyebrow level-page__eyebrow">Niveau {level.n}</p>
      <h1>{level.label}</h1>
      <p class="level-page__tagline">{level.tagline}</p>
      <p class="level-page__meta num">
        {lessons.length} leçons réparties sur {groups.length} systèmes · ≈ {totalHours(lessons)} h d'atelier
      </p>
      <div class="level-page__progress">
        <ProgressBar lessonIds={ids} label={`Progression du niveau ${level.n}`} />
      </div>
    </header>

    {
      groups.map((group) => (
        <section class="system-group" aria-labelledby={`systeme-${group.system}`}>
          <div class="system-group__head">
            <h2 id={`systeme-${group.system}`}>
              <a href={systemUrl(group.system)}>{SYSTEM_META[group.system].label}</a>
            </h2>
            <span class="system-group__count">{group.lessons.length} leçons</span>
          </div>
          {/*
            The serpentine path is piloted on Niveau 1 while its ordering and layout are
            being validated. Rolling it out to the other levels is deleting this
            condition — nothing else depends on the branch.
          */}
          {level.n === 1 ? (
            <LessonPath
              lessons={group.lessons}
              label={`${SYSTEM_META[group.system].label} — niveau ${level.n}`}
            />
          ) : (
            <div class="grid">
              {group.lessons.map((lesson) => (
                <LessonCard lesson={lesson} />
              ))}
            </div>
          )}
        </section>
      ))
    }

    <nav class="level-nav" aria-label="Autres niveaux">
      {
        LEVELS.map((other) => (
          <a
            href={href('niveau', other.n)}
            aria-current={other.n === level.n ? 'page' : undefined}
          >
            {other.n}. {other.label}
          </a>
        ))
      }
    </nav>
  </div>
</BaseLayout>

<style>
  .level-page {
    padding-block: var(--space-5) var(--space-8);
  }

  .level-page__header {
    padding-block: var(--space-5) var(--space-6);
  }

  .level-page__eyebrow {
    color: var(--indigo);
  }

  .level-page__tagline {
    margin-top: var(--space-3);
    max-width: var(--measure);
    font-size: var(--text-lg);
    color: var(--ink-muted);
  }

  .level-page__meta {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--acier);
  }

  .level-page__progress {
    margin-top: var(--space-4);
    max-width: 28rem;
  }

  .system-group + .system-group {
    margin-top: var(--space-7);
  }

  .system-group__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
  }

  .system-group__head h2 {
    font-size: var(--text-xl);
  }

  .system-group__head a {
    color: inherit;
    text-decoration: none;
  }

  .system-group__head a:hover {
    color: var(--indigo);
  }

  .system-group__count {
    font-size: var(--text-sm);
    color: var(--acier);
    white-space: nowrap;
  }

  .grid {
    margin-top: var(--space-4);
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }

  .level-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
    font-size: var(--text-sm);
  }

  .level-nav a {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--ink-muted);
  }

  .level-nav a:hover {
    border-color: var(--line-strong);
    color: var(--ink);
  }

  .level-nav a[aria-current='page'] {
    background: var(--indigo-soft);
    border-color: transparent;
    color: var(--indigo);
    font-weight: 600;
  }
</style>
